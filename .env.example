# Public URL students reach the app on (used in QR codes and login emails)
PUBLIC_URL=https://quiz.example.university.nl
# At least 32 random characters: openssl rand -base64 48
APP_SECRET=
# Comma-separated; only these email domains can log in
ALLOWED_EMAIL_DOMAINS=vu.nl,student.vu.nl
# Comma-separated; these addresses get the teacher role
TEACHER_EMAILS=
# SMTP for login codes. Without it, codes are printed to the server log (dev only).
SMTP_URL=smtps://user:pass@smtp.example.nl:465
SMTP_FROM=Qriz <noreply@example.nl>
# Optional tuning
# SESSION_DAYS=180
# QR_MAX_AGE_MS=8000      # older scans are rejected
# QR_SLOW_SCAN_MS=5000    # slower scans are accepted but flagged
# QR_ROTATE_MS=2000
# PAPER_SECONDS=20       # length of the optional paper round
